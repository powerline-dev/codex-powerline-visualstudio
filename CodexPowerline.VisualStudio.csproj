<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk.WindowsDesktop" />
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CodexPowerline.VisualStudio</AssemblyName>
    <RootNamespace>CodexPowerline.VisualStudio</RootNamespace>
    <Version>0.1.2</Version>
    <PlatformTarget>x64</PlatformTarget>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <UseCodebase>true</UseCodebase>
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <VSToolsPath Condition="'$(VSToolsPath)' == ''">$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v17.0</VSToolsPath>
    <DeployExtension>false</DeployExtension>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Design" />
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2142" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Compile Remove="tests\**" />
    <VSCTCompile Include="src\Commands.vsct"><ResourceName>Menus.ctmenu</ResourceName></VSCTCompile>
    <None Include="source.extension.vsixmanifest"><SubType>Designer</SubType></None>
    <Content Include="web\dist\**\*;runtime\**\*;assets\icon.png;assets\header.png;assets\preview.png;assets\platforms\*.png;assets\platforms\*.txt;assets\platforms\SOURCES.md;docs\development.md;assets\fonts\*;LICENSE;NOTICE;README.md">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(NuGetPackageRoot)microsoft.web.webview2\1.0.3537.50\runtimes\win-x64\native\WebView2Loader.dll">
      <Link>WebView2Loader.dll</Link><IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="CheckTerminalAssets" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('web\dist\index.html') Or !Exists('runtime\terminal-host.cjs')" Text="Run npm ci and npm run build before building the VSIX." />
  </Target>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk.WindowsDesktop" />
  <Import Project="$(NuGetPackageRoot)microsoft.vssdk.buildtools\17.14.2142\tools\vssdk\Microsoft.VsSDK.targets" />
</Project>
